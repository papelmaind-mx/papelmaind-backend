# ============================================================
# PapelMaind — Variables de entorno
# ============================================================
# Copia este archivo a .env y rellena los valores.
# NUNCA commitear .env (está en .gitignore)

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://erp_app:app_change_me@localhost:5432/papeleria
WORKER_DATABASE_URL=postgresql+asyncpg://erp_worker:worker_change_me@localhost:5432/papeleria

# --- Admin de Postgres (solo para init) ---
POSTGRES_ADMIN_PASSWORD=admin_change_me

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET=cambiar_en_prod_minimo_64_chars_aqui_para_seguridad
JWT_ALGORITHM=HS256

# --- Encryption (Fernet) ---
ENCRYPTION_KEY=Z2VuZXJhdGVfdHVfZmVybmV0X2tleV9lbl9wcm9kdWNjaW9uX2FxdWk=

# --- PAC CFDI ---
PAC_PRIMARY=SW_SMARTER
PAC_FALLBACK=FACTURAMA

# --- Kafka (vacío en P0) ---
KAFKA_BOOTSTRAP_SERVERS=

# --- Pool sizing ---
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- LLM Gateway (BYO-LLM) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=

# --- WhatsApp ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# --- Entorno ---
ENVIRONMENT=development
LOG_LEVEL=INFO
